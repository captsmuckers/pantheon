# Copy to .env and fill in the blanks. Values left blank here are
# secrets or machine-specific; everything else is a working default.

# ---- Discord ----
# Generate a NEW token; the one in the old script is burned.
DISCORD_TOKEN=
ALLOWED_CHANNEL_ID=
STATUS_CHANNEL_ID=

# ---- Plex ----
PLEX_URL=
# Reset this too: Plex account settings -> Devices -> sign out all.
PLEX_TOKEN=
EXCLUDE_LIBRARIES=

# ---- mpv ----
# Leave blank if mpv is on PATH. `brew install mpv` puts it there, so on macOS
# this normally stays empty.
MPV_PATH=
MPV_FULLSCREEN=true
# Optional extra mpv options, comma separated.
#
# videotoolbox is the macOS hardware decoder — the Apple silicon media engine
# rather than the GPU proper, which matters here because it leaves the GPU free
# for whatever is encoding the screen share. auto-safe would find it anyway;
# naming it means a failure to use it is visible in the mpv log instead of
# silently falling back to software decode.
MPV_EXTRA_OPTS=hwdec=videotoolbox,vo=gpu-next

# ---- Behaviour ----
AUTOPLAY_NEXT_EPISODE=true
FREEZE_TIMEOUT=45

# ---- Spotify (optional; playback control needs Premium) ----
# Register at developer.spotify.com. Redirect URI must be 127.0.0.1, NOT localhost.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
# Optional: match a Connect device by name, and let the bot launch the app
SPOTIFY_DEVICE_NAME=
# Blank uses `open -a Spotify` on macOS. Set a full command line to override.
SPOTIFY_EXE=

# ---- YouTube age-gate fallback ----
# A link that hits YouTube's age gate opens in a real, signed-in Firefox
# window instead of just failing. No playback control once it's open. Create
# the profile once with `/Applications/Firefox.app/Contents/MacOS/firefox -P`,
# name it to match BROWSER_PROFILE, and sign into YouTube inside it.
YOUTUBE_BROWSER_FALLBACK=true
BROWSER_PATH=
BROWSER_PROFILE=Athena
BROWSER_KIOSK=true

# ---- Voice commands ----
# Spoken commands, captured from the LOCAL Discord client's audio output via a
# virtual audio device — not Discord's voice-receive API, which has been
# unusable since DAVE end-to-end encryption was enforced in March 2026.
#
# macOS uses BlackHole where Windows used VB-Audio Cable:
#
#     brew install blackhole-2ch
#
# One difference matters. VB-Cable is a pair of endpoints with different names
# ("CABLE Input" to write to, "CABLE Output" to read from); BlackHole is a
# single device that is both, so the same name goes in VOICE_DEVICE and in
# Discord's output setting.
#
# The other difference is that routing audio to BlackHole sends it ONLY there —
# you stop hearing it. Fix that with a Multi-Output Device in Audio MIDI Setup
# (Applications > Utilities) containing both BlackHole 2ch and your speakers,
# and point Discord at that instead.
#
# Setup, all of which must hold or the cable carries digital silence:
#   1. Point Discord's output device at the Multi-Output Device (or at
#      "BlackHole 2ch" directly, if you don't need to hear it yourself)
#   2. Turn Discord's own Output Volume up (Settings -> Voice & Video)
#   3. Leave and rejoin the voice channel; Discord will not migrate a live
#      connection to a newly selected device
# The streaming account must be MUTED, never DEAFENED — a deafened client
# receives no audio at all, so there is nothing to capture.
#
# Needs: pip install -r requirements-dev.txt
VOICE_ENABLED=false
VOICE_DEVICE=BlackHole 2ch
# true = transcribe, wake-match and log, but never act. Leave it on until the
# log shows the wake word firing reliably and nothing else firing at all.
VOICE_DRY_RUN=true
# Every utterance, its verdict, and what the bot did — one line each, in its
# own file, for tuning the wake list. The bot's main log deliberately records
# only the shape of an utterance, never the words, because everyone's
# conversation passes through the transcriber. Blank disables this file.
VOICE_TUNING_LOG=logs/voice-tuning.log
# Blank uses the built-in defaults, which are what Whisper actually produces
# for "Athena". The "hey/hi/ok" prefix is required on purpose: biasing recognition
# toward a rare name makes it hallucinate that name out of silence.
VOICE_WAKE_WORDS=
VOICE_WAKE_PREFIXES=
VOICE_REQUIRE_PREFIX=true
VOICE_THRESHOLD=0.003
VOICE_SILENCE_MS=1000
VOICE_PREROLL_MS=500
VOICE_MIN_MS=400
VOICE_MAX_S=10
VOICE_MAX_WORDS=14
VOICE_STT_TIMEOUT=30
# Measured on an M1 Max (int8, 6 threads, 3.4s clip): tiny 15.9x realtime,
# base 13.4x, small 4.8x, medium 1.7x. base is fast but got the words wrong;
# small is the first size that was both correct and comfortably quick.
WHISPER_MODEL=small
# No CUDA and no Metal backend in CTranslate2 — the CPU is the only device on a
# Mac. int8 uses NEON on Apple silicon.
WHISPER_DEVICE=cpu
WHISPER_COMPUTE=int8
# CTranslate2 threads. This host has 8 performance cores and 2 efficiency ones;
# 6 leaves headroom for the bot, mpv and the screen-share encoder. Measured: 8
# threads was no faster than 6, so the headroom is free.
WHISPER_CPU_THREADS=6

# ---- Idle screen ----
# A still shown between things, so a shared screen is never a frozen frame or a
# black one. Blank means mpv shows its own default. Any image mpv can open works,
# and it is displayed indefinitely, so something wide suits a shared screen.
IDLE_IMAGE=

# ---- Now playing ----
NOWPLAYING_ENABLED=false

# ---- Music window handling / karaoke ----
MUSIC_MINIMIZE_MPV=true
MUSIC_FOCUS_SPOTIFY=true
MPV_WINDOW_TITLE=Athena
SPOTIFY_PROCESS=Spotify
KARAOKE_DEFAULT=false

# ---- Natural language backend ----
# "ollama", or blank to auto-pick (which means ollama when OLLAMA_MODEL is set).
# The Anthropic backend was removed — this runs the model locally and there
# is no remote fallback. With Ollama down, the bot degrades to fast_match plus
# offline_match: play/pause/skip/back still work, fuzzy requests don't.
NL_BACKEND=
OLLAMA_HOST=http://127.0.0.1:11434
# One model, on the GPU, for everything. CPU inference is not used on this
# machine regardless of how it benchmarks.
#
# granite4:3b chosen 2026-08-13 after a bake-off on the RTX 2060 against
# qwen2.5:7b, qwen3.5:4b, gemma4:e2b, nemotron-3-nano:4b and granite4:7b-a1b-h.
# It scored 5/7 on the tool suite vs qwen2.5:7b's 2/7, and — the reason it wins —
# fabricated zero times in 21 case-runs. The others narrate fake actions
# ("Playing **Nacho Libre**.") with no tool call behind them. Uses 3.0GB VRAM,
# prefills at 2648 tok/s, no thinking mode.
#
# Fallback is qwen3.5:4b (4/7, also zero fabrications). It is a thinking model;
# the "reasoning traces instead of replies" hazard that used to make it risky is
# handled now — see OLLAMA_THINK below, which defaults to sending think: false.
#
# SUPERSEDED on the M1 Max, 2026-08-24. granite4:3b was chosen above against an
# 8GB VRAM ceiling and it held up on tool calling — 26/27 here, and no model in
# the field fabricated even once, so that whole criterion has gone quiet.
#
# It lost on CONVERSATION, which the old bake-off never measured:
#
#   classify_intent routing   granite4:3b  9/12     qwen3:8b  12/12
#   tool calling              granite4:3b 26/27     qwen3:8b  27/27
#
# granite routed "write me a haiku about the office" to MEDIA — the exact
# failure chat_only()'s docstring was written about — and answered "who even
# are you" as "a manifestation of wisdom and strategic thought", which is the
# Greek goddess rather than this character. qwen3:8b answers "I am here to be
# unimpressed". FLAVOR_MODEL follows this setting, so that voice is on nearly
# every reply, not just the conversational ones.
#
# granite4:3b is kept installed as a fallback. Re-measure with
# scripts/bakeoff.py (tools) and scripts/chatoff.py (routing and voice).
OLLAMA_MODEL=qwen3:8b
# Cold prefill of the ~3000-token tool schema can exceed the old 60s ceiling
# and report a failure that never happened. Warm requests are far quicker,
# since Ollama caches the prompt prefix.
OLLAMA_TIMEOUT=180
# How long Ollama keeps the model in memory. Its default is 5 minutes, which
# means the first question after a quiet evening pays a full reload — measured
# at 12.5s cold against 2.1s warm for qwen3:8b. -1 pins it indefinitely, at the
# cost of ~8GB of the 32GB staying held. 0 unloads immediately; a number is
# seconds; "30m" also works.
OLLAMA_KEEP_ALIVE=-1
# Reasoning models write their chain of thought out as reply text unless told
# not to. Blank sends "think": false, which is what you want. "true" lets them
# think (for comparing by hand); "none" omits the field entirely, for an Ollama
# too old to know it or a model that rejects it.
OLLAMA_THINK=
BOT_PERSONA=Dry, unhurried, faintly amused. Answers plainly and does not gush. Add a little colour in this voice, but never state what happened as a substitute for actually doing it.
# Mixed into the flavour narrator on FLAVOR_FLOURISH_CHANCE of replies only.
# Kept apart because a 7B treats "occasionally reference X" as "always": with
# this text inside BOT_PERSONA, 5 lines in 8 were about silence and static.
BOT_PERSONA_FLOURISH=
FLAVOR_FLOURISH_CHANCE=0.35
# How the aside joins the factual line.
#   inline  Stopped and cleared the queue. What a waste of time.
#   line    Stopped and cleared the queue.
#           _what a waste of time._
# inline is the default: a separate italic sentence under every reply reads as
# a footnote in a second voice rather than the same person still talking. A
# multi-line result (a queue listing, say) uses the footnote either way.
FLAVOR_STYLE=inline
# Ceiling on an aside's length, in characters. Measured against qwen3:8b the
# asides it actually writes run 40-90 characters, so 120 is a guard rail rather
# than a routine trim — lower it to around 70 if you want them reliably clipped
# to one sentence. Trimming cuts at a sentence boundary wherever it can.
FLAVOR_MAX_LENGTH=120
