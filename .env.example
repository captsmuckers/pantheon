# Copy to .env and fill in the blanks.
#
# GENERATED FROM schema.py — do not edit by hand, the next regeneration will
# overwrite it. Change a setting's description or default in schema.py and run
# scripts/gen-env-example.py.
#
# Only the four settings marked REQUIRED are needed to start. Everything else
# has a working default, and the advanced ones are worth leaving alone until
# something specific is wrong.
#
# Values here are examples, not secrets. Your real .env holds tokens and should
# be mode 600; it is gitignored and must never be committed.

# ---- Discord -----------------------------------------------------------

# [REQUIRED]
# Bot token from the Discord Developer Portal. The bot also needs the
# Message Content Intent enabled there, under Bot > Privileged Gateway
# Intents, or it will connect and then ignore every message.
DISCORD_TOKEN=

# [REQUIRED]
# The text channel it listens in. Anything said there that does not start
# with a punctuation prefix is treated as a request.
ALLOWED_CHANNEL_ID=

# Optional. A channel whose topic is kept up to date with what is playing.
# Needs the Manage Channels permission.
STATUS_CHANNEL_ID=

# ---- Plex --------------------------------------------------------------

# [REQUIRED]
# e.g. http://192.168.1.10:32400. The machine running the bot must reach
# this directly — mpv plays the original file and there is no transcode
# fallback.
PLEX_URL=

# [REQUIRED]
# Plex account settings > Devices will show one, or sign out of all devices
# and take a fresh one.
PLEX_TOKEN=

# Libraries to ignore, matched as a substring — "4K" hides any library whose
# name contains it. Blank excludes nothing.
EXCLUDE_LIBRARIES=

# [advanced]
# Libraries that should default to subtitled audio. Blank means none.
ANIME_LIBRARIES=

# ---- Player ------------------------------------------------------------

# Leave blank if mpv is on PATH, which it is after `brew install mpv` or
# `winget install mpv`.
MPV_PATH=

# Fullscreen on launch. The point of this bot is a shared screen, so this is
# almost always what you want.
MPV_FULLSCREEN=true

# [advanced] [macOS only]
# Any mpv options, comma separated. videotoolbox decodes on Apple silicon's
# media engine rather than the GPU, which leaves the GPU for whatever is
# encoding the screen share.
MPV_EXTRA_OPTS=hwdec=videotoolbox,vo=gpu-next

# [advanced] [macOS only] [one of: no, yes]
# macOS only. "no" keeps mpv on the current Space, which is what a screen
# share needs. "yes" is the green-button fullscreen, which moves it to a
# Space of its own AND breaks minimising.
MPV_NATIVE_FS=no

# A still shown between things, so a shared screen is never a frozen frame.
# Blank means mpv shows its own default.
IDLE_IMAGE=

# [advanced]
# What the player window is called, and how the bot finds it again.
MPV_WINDOW_TITLE=Athena

# ---- Model -------------------------------------------------------------

# Where Ollama is listening.
OLLAMA_HOST=http://127.0.0.1:11434

# The model for tool calling and conversation. Judge a candidate on how
# often it claims an action it did not take, not on size — a 3B has beaten
# every 14B tried here on exactly that.
OLLAMA_MODEL=qwen3:8b

# [advanced]
# Optional separate model for the one-line asides, which fire far more often
# than tool calls. Blank follows OLLAMA_MODEL.
FLAVOR_MODEL=

# [advanced]
# How long Ollama keeps the model in memory. Its default of 5 minutes means
# the first question after a quiet evening pays a full reload. -1 pins it,
# at the cost of holding the memory.
OLLAMA_KEEP_ALIVE=-1

# [advanced] [one of: (blank), true, none]
# Blank sends think:false, which is what you want — a reasoning model left
# to think writes its deliberation out as the reply. "none" omits the field
# for an Ollama too old to know it.
OLLAMA_THINK=

# [advanced] [range 10-600]
# Cold prefill of the tool schema can take a while on slow hardware.
OLLAMA_TIMEOUT=180

# Who it is. Describe a voice, not a set of rules. Keep it about manner
# rather than actions — persona pressure in the tool prompt measurably
# traded against tool discipline.
BOT_PERSONA=

# [advanced]
# An occasional extra flavour, mixed in on FLAVOR_FLOURISH_CHANCE of
# replies. Kept apart because a small model treats "occasionally reference
# X" as "always".
BOT_PERSONA_FLOURISH=

# The short asides appended to replies.
FLAVOR_ENABLED=true

# [one of: inline, line]
# inline runs the aside on as part of the sentence; line puts it underneath
# in italics, which reads as a footnote in a second voice.
FLAVOR_STYLE=inline

# [advanced] [range 40-400]
# Ceiling on an aside. Trimming cuts at a sentence boundary.
FLAVOR_MAX_LENGTH=120

# [advanced] [range 0-1]
FLAVOR_FLOURISH_CHANCE=0.35

# [advanced] [range 1-60]
# An aside is cosmetic — it is dropped rather than allowed to delay the
# reply.
FLAVOR_TIMEOUT=8.0

# ---- Spotify -----------------------------------------------------------

# Register an app at developer.spotify.com. Playback control needs a Premium
# account.
SPOTIFY_CLIENT_ID=

SPOTIFY_CLIENT_SECRET=

# [advanced]
# Must be a loopback address, not localhost — Spotify stopped accepting
# localhost.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# [advanced]
# Match a Connect device by substring. Blank picks the active one.
SPOTIFY_DEVICE_NAME=

# ---- Voice -------------------------------------------------------------

# Spoken commands, captured from the Discord client's audio output through a
# virtual cable. Needs the dev requirements installed.
VOICE_ENABLED=false

# [macOS only]
# The loopback device Discord plays into. macOS has none built in: `brew
# install --cask blackhole-2ch`.
VOICE_DEVICE=BlackHole 2ch

# Spellings the transcriber actually produces for the bot's name. Blank uses
# the built-in list.
VOICE_WAKE_WORDS=

# [advanced]
# Demand "hey"/"ok" before the name. Short unstressed words are the first
# thing a noise gate eats, so this costs wakes.
VOICE_REQUIRE_PREFIX=false

# Transcribe, wake-match and log, but never act. Leave on until the log
# shows the wake word firing reliably and nothing else firing.
VOICE_DRY_RUN=true

# [one of: tiny, base, small, medium, large-v3, distil-large-v3]
# Measured on an M1 Max, int8: tiny 15.9x realtime, base 13.4x, small 4.8x,
# medium 1.7x. base is quick and gets words wrong, which is the worse
# failure — a mis-heard command silently does nothing.
WHISPER_MODEL=small

# [advanced] [one of: cpu, cuda]
# CTranslate2 has no Metal backend, so macOS is CPU whatever this says.
WHISPER_DEVICE=cpu

# [advanced] [range 1-16]
# Leave headroom: on a busy channel this runs almost continuously, and
# starving the audio system makes playback break up.
WHISPER_CPU_THREADS=6

# [advanced]
# Every utterance and the verdict it got — the raw material for tuning the
# wake list. This is the one place the words are written down, so blank
# turns it off in one place rather than an audit.
VOICE_TUNING_LOG=logs/voice-tuning.log

# The VOICE channel to sit in — not the text channel it talks in. Needed
# only for speaker attribution and for speaking replies.
VOICE_CHANNEL_ID=

# Name who spoke each line in the tuning log. Requires holding a voice
# connection, so the bot appears in the channel; it joins muted and
# transmits nothing.
VOICE_TRACK_SPEAKERS=false

# [advanced]
# Accepted before the name. Blank uses the built-in list.
VOICE_WAKE_PREFIXES=

# [advanced]
# Whole-phrase renderings for when recognition fuses the prefix into the
# name. Each entry is damage control for a badly-heard name.
VOICE_WAKE_COMPOUNDS=

# [advanced]
# Save each utterance as a WAV so a mis-heard command can be listened to
# rather than guessed at. This records everyone in the channel, so it is a
# tuning tool and not something to leave on.
VOICE_SAVE_AUDIO=

# [advanced] [range 1-5000]
VOICE_SAVE_AUDIO_KEEP=200

# [advanced] [one of: int8, int8_float16, float16, float32]
# int8 uses NEON on Apple silicon and is the reason CPU transcription is
# usable at all.
WHISPER_COMPUTE=int8

# [advanced] [range 1-10]
# Beam search rather than greedy. Utterances are seconds long and the model
# runs far faster than realtime, so the latency is invisible while the
# accuracy is not.
VOICE_BEAM_SIZE=5

# [advanced] [range 0-1]
# Energy gate. The cable carries exact digital silence between utterances,
# so a plain gate is enough.
VOICE_THRESHOLD=0.003

# [advanced] [range 100-5000]
# How much quiet ends an utterance.
VOICE_SILENCE_MS=1000

# [advanced] [range 0-3000]
# Audio kept from before the gate opened, so a clipped attack does not eat
# the wake word.
VOICE_PREROLL_MS=500

# [advanced] [range 50-3000]
VOICE_MIN_MS=400

# [advanced] [range 2-60]
# Anything longer is a conversation, not an instruction.
VOICE_MAX_S=10.0

# [advanced] [range 3-60]
VOICE_MAX_WORDS=14

# [advanced] [range 5-300]
VOICE_STT_TIMEOUT=30.0

# [advanced] [range 0-10000]
# How far outside an utterance a speaking frame still counts as belonging to
# it. Deliberately loose: the audio and the signalling arrive by independent
# paths with independent latency.
VOICE_SPEAKER_TOLERANCE_MS=1500

# ---- Speech ------------------------------------------------------------

# Whether she speaks her replies into the voice channel.
TTS_ENABLED=false

# [restarts the TTS service] [one of: kokoro, chatterbox]
# kokoro is ~0.2s a reply and mispronounces proper nouns. chatterbox reads
# them correctly and takes ~8s, holding ~200% CPU while it does, which can
# break playback up on a loaded machine.
TTS_ENGINE=kokoro

# [restarts the TTS service]
# Kokoro voice name. 54 are published; bf_* and bm_* are British.
TTS_VOICE=bf_emma

# [restarts the TTS service]
# Chatterbox only. A clip of the voice to clone. Only the first ~10 seconds
# are read, so it should be the best ten, not the longest.
TTS_VOICE_REF=

# [advanced]
TTS_URL=http://127.0.0.1:8085

# [advanced] [range 80-2000]
# Long replies are where a slow engine hurts most.
TTS_MAX_CHARS=600

# A short pre-rendered "heard you" the moment a wake word lands. The problem
# it solves is not the delay, it is the silence.
TTS_ACK_ENABLED=true

# [advanced]
# Separated by ||. Delete the acks directory to re-render.
TTS_ACK_LINES=Mm. || Fine. || One moment. || If I must. || Working on it.

# [macOS only]
# The return cable, feeding Discord's microphone. A SECOND device, not the
# capture one — sharing one would feed her own voice back.
TTS_OUTPUT_DEVICE=BlackHole 16ch

# [advanced] [range 5-600]
# Raise this if using a slow engine — chatterbox takes ~8s a reply.
TTS_TIMEOUT=60.0

# [advanced] [range 0-3000]
# Capture stays suppressed this long past the end of playback: the tail is
# still moving through Discord's encoder and someone else's open mic can
# echo it back.
TTS_ECHO_GUARD_MS=400

# ---- Behaviour ---------------------------------------------------------

# Load the next episode when one finishes, rather than stopping.
AUTOPLAY_NEXT_EPISODE=true

# [advanced] [range 10-300]
# How long playback may stall before the watchdog reloads at the last known
# position.
FREEZE_TIMEOUT=45

# Draw synced lyrics over the idle screen while music plays.
KARAOKE_DEFAULT=false

# Post a message to a channel whenever the track changes.
NOWPLAYING_ENABLED=false

# [advanced]
# Get the player out of the way when music starts, so a shared screen shows
# the music app rather than a still image.
MUSIC_MINIMIZE_MPV=true

# [advanced]
# Bring the music app forward when music starts.
MUSIC_FOCUS_SPOTIFY=true

# [advanced]
# Fill the screen with it, so viewers can read the queue.
MUSIC_MAXIMIZE_SPOTIFY=true

# [advanced]
# Where now-playing messages go, if enabled.
NOWPLAYING_CHANNEL_ID=

# ---- YouTube -----------------------------------------------------------

# A link that hits YouTube's age gate opens in a real signed-in browser
# instead of failing. There is no playback control once it is open.
YOUTUBE_BROWSER_FALLBACK=true

# [advanced]
# Blank finds Firefox in the usual places.
BROWSER_PATH=

# [advanced]
# A dedicated Firefox profile, so the bot's YouTube login is its own and not
# whoever's is signed in.
BROWSER_PROFILE=Athena

# [advanced]
BROWSER_KIOSK=true

# [advanced]
# Blank prefers H.264 at 1080p. Worth leaving alone: AV1 has no hardware
# decoder on Apple silicon before M3, and left to itself "best" resolves to
# AV1.
YTDL_FORMAT=

# [advanced] [range 5-120]
YOUTUBE_TIMEOUT=20.0

# ---- Languages ---------------------------------------------------------

# Preferred audio track when a file offers several.
DEFAULT_AUDIO_LANG=English

# Preferred subtitle track. "off" means none.
DEFAULT_SUBTITLE_LANG=off

# [advanced]
# Applied to libraries named in ANIME_LIBRARIES.
ANIME_AUDIO_LANG=Japanese

# [advanced]
ANIME_SUBTITLE_LANG=English
