# Copy to .env and fill in the blanks.
#
# GENERATED FROM schema.py — do not edit by hand, the next regeneration will
# overwrite it. Change a setting's description or default in schema.py and run
# scripts/gen-env-example.py.
#
# Only the four settings marked REQUIRED are needed to start. Everything else
# has a working default, and the advanced ones are worth leaving alone until
# something specific is wrong.
#
# Values here are examples, not secrets. Your real .env holds tokens and should
# be mode 600; it is gitignored and must never be committed.

# ---- Discord -----------------------------------------------------------

# What she is called. Sets the mpv window title, the device Plex sees, the
# Firefox profile and the spoken wake word, all at once. Renaming is not
# free: the wake word was chosen by measurement — "Athena" was heard 26
# times in 28 against 6 in 9 for "Jarvis" and 0 in 4 for "Lilith", because
# Discord's voice gate clips the opening consonant and names starting on an
# open vowel survive it. A name beginning with a hard consonant will be
# missed often.
BOT_NAME=Athena

# [REQUIRED]
# Bot token from the Discord Developer Portal. The bot also needs the
# Message Content Intent enabled there, under Bot > Privileged Gateway
# Intents, or it will connect and then ignore every message.
DISCORD_TOKEN=

# [REQUIRED]
# The text channel it listens in. Anything said there that does not start
# with a punctuation prefix is treated as a request.
ALLOWED_CHANNEL_ID=

# Optional. A channel whose topic is kept up to date with what is playing.
# Needs the Manage Channels permission.
STATUS_CHANNEL_ID=

# ---- Plex --------------------------------------------------------------

# [REQUIRED]
# e.g. http://192.168.1.10:32400. The machine running the bot must reach
# this directly — mpv plays the original file and there is no transcode
# fallback.
PLEX_URL=

# [REQUIRED]
# Plex account settings > Devices will show one, or sign out of all devices
# and take a fresh one.
PLEX_TOKEN=

# Libraries to ignore, matched as a substring — "4K" hides any library whose
# name contains it. Blank excludes nothing.
EXCLUDE_LIBRARIES=

# [advanced]
# Libraries that should default to subtitled audio. Blank means none.
ANIME_LIBRARIES=

# ---- Player ------------------------------------------------------------

# Leave blank if mpv is on PATH, which it is after `brew install mpv` or
# `winget install mpv`.
MPV_PATH=

# Fullscreen on launch. The point of this bot is a shared screen, so this is
# almost always what you want.
MPV_FULLSCREEN=true

# [advanced] [macOS only]
# Any mpv options, comma separated. videotoolbox decodes on Apple silicon's
# media engine rather than the GPU, which leaves the GPU for whatever is
# encoding the screen share.
MPV_EXTRA_OPTS=hwdec=videotoolbox,vo=gpu-next

# [advanced] [macOS only] [one of: no, yes]
# macOS only. "no" keeps mpv on the current Space, which is what a screen
# share needs. "yes" is the green-button fullscreen, which moves it to a
# Space of its own AND breaks minimising.
MPV_NATIVE_FS=no

# A still shown between things, so a shared screen is never a frozen frame.
# Blank means mpv shows its own default.
IDLE_IMAGE=

# [advanced]
# What the player window is called, and how the bot finds it again.
MPV_WINDOW_TITLE=

# ---- Model -------------------------------------------------------------

# Where Ollama is listening.
OLLAMA_HOST=http://127.0.0.1:11434

# The model for tool calling and conversation. Judge a candidate on how
# often it claims an action it did not take, not on size — a 3B has beaten
# every 14B tried here on exactly that.
OLLAMA_MODEL=qwen3:8b

# [advanced]
# Optional separate model for the one-line asides, which fire far more often
# than tool calls. Blank follows OLLAMA_MODEL.
FLAVOR_MODEL=

# [advanced]
# How long Ollama keeps the model in memory. Its default of 5 minutes means
# the first question after a quiet evening pays a full reload. -1 pins it,
# at the cost of holding the memory.
OLLAMA_KEEP_ALIVE=-1

# [advanced] [one of: (blank), true, none]
# Blank sends think:false, which is what you want — a reasoning model left
# to think writes its deliberation out as the reply. "none" omits the field
# for an Ollama too old to know it.
OLLAMA_THINK=

# [advanced] [range 10-600]
# Cold prefill of the tool schema can take a while on slow hardware.
OLLAMA_TIMEOUT=180

# Who it is. Describe a voice, not a set of rules. Keep it about manner
# rather than actions — persona pressure in the tool prompt measurably
# traded against tool discipline.
BOT_PERSONA=

# [advanced]
# An occasional extra flavour, mixed in on FLAVOR_FLOURISH_CHANCE of
# replies. Kept apart because a small model treats "occasionally reference
# X" as "always".
BOT_PERSONA_FLOURISH=

# The short asides appended to replies.
FLAVOR_ENABLED=true

# [one of: inline, line]
# inline runs the aside on as part of the sentence; line puts it underneath
# in italics, which reads as a footnote in a second voice.
FLAVOR_STYLE=inline

# [advanced] [range 40-400]
# Ceiling on an aside. Trimming cuts at a sentence boundary.
FLAVOR_MAX_LENGTH=120

# [advanced] [range 0-1]
FLAVOR_FLOURISH_CHANCE=0.35

# [advanced] [range 40-600]
# Ceiling on a conversational reply. These get spoken, so length is a
# listening cost: 260 tokens is roughly thirty seconds of speech. The
# persona asks for a few lines; this enforces it when the model ignores
# that.
CHAT_MAX_TOKENS=160

# [advanced] [range 1-60]
# An aside is cosmetic — it is dropped rather than allowed to delay the
# reply.
FLAVOR_TIMEOUT=8.0

# ---- Spotify -----------------------------------------------------------

# Register an app at developer.spotify.com. Playback control needs a Premium
# account.
SPOTIFY_CLIENT_ID=

SPOTIFY_CLIENT_SECRET=

# [advanced]
# Must be a loopback address, not localhost — Spotify stopped accepting
# localhost.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# [advanced]
# Match a Connect device by substring. Blank picks the active one.
SPOTIFY_DEVICE_NAME=

# ---- Voice -------------------------------------------------------------

# Spoken commands, captured from the Discord client's audio output through a
# virtual cable. Needs the dev requirements installed.
VOICE_ENABLED=false

# [macOS only]
# The loopback device Discord plays into. macOS has none built in: `brew
# install --cask blackhole-2ch`.
VOICE_DEVICE=BlackHole 2ch

# Spellings the transcriber actually produces for the bot's name. Blank uses
# the built-in list.
VOICE_WAKE_WORDS=

# [advanced]
# Demand "hey"/"ok" before the name. Short unstressed words are the first
# thing a noise gate eats, so this costs wakes.
VOICE_REQUIRE_PREFIX=false

# Transcribe, wake-match and log, but never act. Leave on until the log
# shows the wake word firing reliably and nothing else firing.
VOICE_DRY_RUN=true

# [one of: tiny, base, small, medium, large-v3, distil-large-v3]
# Measured on an M1 Max, int8: tiny 15.9x realtime, base 13.4x, small 4.8x,
# medium 1.7x. base is quick and gets words wrong, which is the worse
# failure — a mis-heard command silently does nothing.
WHISPER_MODEL=small

# [advanced] [one of: cpu, cuda]
# CTranslate2 has no Metal backend, so macOS is CPU whatever this says.
WHISPER_DEVICE=cpu

# [advanced] [range 1-16]
# Leave headroom: on a busy channel this runs almost continuously, and
# starving the audio system makes playback break up.
WHISPER_CPU_THREADS=6

# Write down what the room says. Every utterance the microphone picks up —
# including conversations not addressed to the bot — is transcribed and
# recorded with the verdict it got. It is how you tune the wake word against
# a real room, and it is a record of what people said near the microphone.
# Turn it off and nothing is written; the bot still hears and still
# responds.
VOICE_TUNING_ENABLED=true

# [advanced]
# Where that record goes. Relative paths resolve next to the code.
VOICE_TUNING_LOG=logs/voice-tuning.log

# [advanced] [range 0.1-500]
# Rotate once the file passes this size, in megabytes. A busy room produces
# a line per utterance and this grew to 700 KB in two days, so it is bounded
# rather than left to run.
VOICE_TUNING_MAX_MB=5.0

# [advanced] [range 0-50]
# How many rotated files to keep beside the current one. 0 keeps none, so
# nothing older than the current file survives.
VOICE_TUNING_KEEP=3

# The VOICE channel to sit in — not the text channel it talks in. Needed
# only for speaker attribution and for speaking replies.
VOICE_CHANNEL_ID=

# Name who spoke each line in the tuning log. Requires holding a voice
# connection, so the bot appears in the channel; it joins muted and
# transmits nothing.
VOICE_TRACK_SPEAKERS=false

# [advanced]
# Accepted before the name. Blank uses the built-in list.
VOICE_WAKE_PREFIXES=

# [advanced]
# Whole-phrase renderings for when recognition fuses the prefix into the
# name. Each entry is damage control for a badly-heard name.
VOICE_WAKE_COMPOUNDS=

# [advanced]
# Save each utterance as a WAV so a mis-heard command can be listened to
# rather than guessed at. This records everyone in the channel, so it is a
# tuning tool and not something to leave on.
VOICE_SAVE_AUDIO=

# [advanced] [range 1-5000]
VOICE_SAVE_AUDIO_KEEP=200

# [advanced] [one of: int8, int8_float16, float16, float32]
# int8 uses NEON on Apple silicon and is the reason CPU transcription is
# usable at all.
WHISPER_COMPUTE=int8

# [advanced] [range 1-10]
# Beam search rather than greedy. Utterances are seconds long and the model
# runs far faster than realtime, so the latency is invisible while the
# accuracy is not.
VOICE_BEAM_SIZE=5

# [advanced] [range 0-1]
# Energy gate. The cable carries exact digital silence between utterances,
# so a plain gate is enough.
VOICE_THRESHOLD=0.003

# [advanced] [range 100-5000]
# How much quiet ends an utterance.
VOICE_SILENCE_MS=1000

# [advanced] [range 0-3000]
# Audio kept from before the gate opened, so a clipped attack does not eat
# the wake word.
VOICE_PREROLL_MS=500

# [advanced] [range 50-3000]
VOICE_MIN_MS=400

# [advanced] [range 2-60]
# Anything longer is a conversation, not an instruction.
VOICE_MAX_S=10.0

# [advanced] [range 3-60]
VOICE_MAX_WORDS=14

# [advanced] [range 5-300]
VOICE_STT_TIMEOUT=30.0

# [advanced] [range 0-10000]
# How far outside an utterance a speaking frame still counts as belonging to
# it. Deliberately loose: the audio and the signalling arrive by independent
# paths with independent latency.
VOICE_SPEAKER_TOLERANCE_MS=1500

# ---- Speech ------------------------------------------------------------

# Whether she speaks her replies into the voice channel.
TTS_ENABLED=false

# [restarts the TTS service] [one of: kokoro, chatterbox, qwen]
# Which speech engine runs. This decides which of the fields below do
# anything. • kokoro: 54 fixed voices, ~0.4s a line, the fastest by far.
# Cannot copy a voice. Mispronounces proper nouns. • qwen: ~1-2s a line. Can
# use 9 built-in voices, invent one from a written description, or copy one
# from a recording — pick which with 'Qwen model' below. Recommended. •
# chatterbox: copies a voice from a recording. ~2.4s a line and slower on
# short ones than long. Kept for comparison; qwen does the same job faster.
TTS_ENGINE=kokoro

# [restarts the TTS service] [one of:
# mlx-community/Qwen3-TTS-12Hz-1.7B-CustomVoice-8bit,
# mlx-community/Qwen3-TTS-12Hz-0.6B-CustomVoice-8bit,
# mlx-community/Qwen3-TTS-12Hz-1.7B-VoiceDesign-8bit,
# mlx-community/Qwen3-TTS-12Hz-1.7B-Base-8bit,
# mlx-community/Qwen3-TTS-12Hz-0.6B-Base-8bit]
# How the Qwen voice is chosen. The name says which: • CustomVoice — pick
# one of 9 ready-made voices. • VoiceDesign — describe the voice you want in
# words. • Base — copy a voice from a recording you upload. 1.7B sounds
# slightly better than 0.6B and is about 20% slower; both are comfortably
# faster than real time. Changing this loads different weights, so it takes
# about 30 seconds.
TTS_QWEN_MODEL=mlx-community/Qwen3-TTS-12Hz-1.7B-CustomVoice-8bit

# Describe the voice you want, in plain English — age, accent, pitch and
# manner all work: "a woman in her thirties with a low, dry, aristocratic
# English voice, bored and faintly contemptuous". Typing here changes
# nothing on its own: press Test this description to hear it in your
# browser, then Save and restart the bot for her to use it in Discord. The
# wording matters more than you would expect and is hard to predict, so
# expect to test a few.
TTS_VOICE_DESIGN=

# [restarts the TTS service]
# What is actually said in the recording above. Filled in for you when you
# upload — check it, because it is transcribed automatically and is
# occasionally wrong. Qwen copies a voice noticeably better when it has both
# the audio and the words; leaving this blank still works, it just sounds
# less like the original and nothing warns you.
TTS_VOICE_REF_TEXT=

# Which ready-made voice to use. Under Qwen CustomVoice these are Vivian,
# Serena, Uncle_Fu, Dylan, Eric, Ryan, Aiden, Ono_Anna and Sohee — press
# Browse voices to see them with descriptions. Under Kokoro they look like
# bf_emma or af_heart, where the first letter is the language and the second
# the sex. The two sets are not interchangeable. Use Test to hear one before
# saving.
TTS_VOICE=bf_emma

# [restarts the TTS service] [one of: auto, a, b, e, f, h, i, j, p, z]
# Kokoro only. Which pronunciation rules to read the text with — separate
# from the voice: the voice decides who it sounds like, this decides how
# words are said. "auto" takes it from the voice name's first letter, which
# is what you want unless you are deliberately reading one language in
# another's accent. Qwen has no equivalent and ignores this.
TTS_LANG_CODE=auto

# [restarts the TTS service]
# A recording of the voice to copy. Press Upload a clip and pick any audio
# or video file — it is trimmed to 10 seconds from the start offset,
# converted and levelled for you. Only the first 6 seconds decide who it
# sounds like, so give it the best 10, one speaker, no music, in the tone
# you want back. A compressed or echoey source is copied faithfully,
# including the compression.
TTS_VOICE_REF=

# [advanced]
TTS_URL=http://127.0.0.1:8085

# [advanced] [range 80-2000]
# Long replies are where a slow engine hurts most.
TTS_MAX_CHARS=600

# A short pre-rendered "heard you" the moment a wake word lands. The problem
# it solves is not the delay, it is the silence.
TTS_ACK_ENABLED=true

# Short things she says the instant she hears you, so a request is not met
# with silence while she thinks. Separate them with || and press Save, then
# restart the bot — that is all; they are rendered at startup and cached
# automatically. Editing or adding a line renders just that one, and clips
# from a previous voice are cleaned up on the next successful start, so
# there is nothing to delete by hand.
TTS_ACK_LINES=Mm. || Fine. || One moment. || If I must. || Working on it.

# Route media audio through a clean virtual device so a Discord screen share
# captures it unprocessed. Without this, macOS renders through the built-in
# speaker route, which applies loudness and protection processing tuned for
# small drivers — the share then captures that, and music arrives bass-light
# with the level pumping. Off by default because it changes the machine's
# default output device. Applied by scripts/setup-stream-audio.py.
STREAM_AUDIO_ENABLED=false

# [advanced]
# The clean virtual device to route media through. Deliberately a THIRD
# device, separate from the two the voice pipeline uses — reusing those
# would mix music into what the transcriber hears and wreck wake-word
# detection. Install with: brew install --cask blackhole-64ch
STREAM_AUDIO_DEVICE=BlackHole 64ch

# [advanced]
# Paired with the clean device so anyone at the machine still hears sound,
# and so the pair has a real hardware clock to follow. Blank detects the
# built-in output automatically.
STREAM_AUDIO_MONITOR=

# [macOS only]
# The return cable, feeding Discord's microphone. A SECOND device, not the
# capture one — sharing one would feed her own voice back.
TTS_OUTPUT_DEVICE=BlackHole 16ch

# Level her voice to a normal speaking level before it goes down the cable.
# Kokoro delivers about -23 dBFS; broadcast speech sits near -18, and the
# quiet end of Kokoro's range is where a voice gate starts cutting
# syllables. Cannot clip — a -1 dBFS peak ceiling always overrides the
# target.
TTS_NORMALIZE=true

# [advanced] [range -40--6]
# The RMS level to aim for, measured over speech only. Louder than about -12
# leaves no headroom for the peaks.
TTS_LEVEL_DBFS=-18.0

# [advanced] [range 5-600]
# Raise this if using a slow engine — chatterbox takes ~8s a reply.
TTS_TIMEOUT=60.0

# [advanced] [range 0-3000]
# Capture stays suppressed this long past the end of playback: the tail is
# still moving through Discord's encoder and someone else's open mic can
# echo it back.
TTS_ECHO_GUARD_MS=400

# ---- Behaviour ---------------------------------------------------------

# Load the next episode when one finishes, rather than stopping.
AUTOPLAY_NEXT_EPISODE=true

# [advanced] [range 10-300]
# How long playback may stall before the watchdog reloads at the last known
# position.
FREEZE_TIMEOUT=45

# Draw synced lyrics over the idle screen while music plays.
KARAOKE_DEFAULT=false

# Post a message to a channel whenever the track changes.
NOWPLAYING_ENABLED=false

# [advanced]
# Get the player out of the way when music starts, so a shared screen shows
# the music app rather than a still image.
MUSIC_MINIMIZE_MPV=true

# [advanced]
# Bring the music app forward when music starts.
MUSIC_FOCUS_SPOTIFY=true

# [advanced]
# Fill the screen with it, so viewers can read the queue.
MUSIC_MAXIMIZE_SPOTIFY=true

# [advanced]
# Where now-playing messages go, if enabled.
NOWPLAYING_CHANNEL_ID=

# ---- YouTube -----------------------------------------------------------

# A link that hits YouTube's age gate opens in a real signed-in browser
# instead of failing. There is no playback control once it is open.
YOUTUBE_BROWSER_FALLBACK=true

# [advanced]
# Blank finds Firefox in the usual places.
BROWSER_PATH=

# [advanced]
# A dedicated Firefox profile, so the bot's YouTube login is its own and not
# whoever's is signed in.
BROWSER_PROFILE=

# [advanced]
BROWSER_KIOSK=true

# [advanced]
# Blank prefers H.264 at 1080p. Worth leaving alone: AV1 has no hardware
# decoder on Apple silicon before M3, and left to itself "best" resolves to
# AV1.
YTDL_FORMAT=

# [advanced] [range 5-120]
YOUTUBE_TIMEOUT=20.0

# ---- Languages ---------------------------------------------------------

# Preferred audio track when a file offers several.
DEFAULT_AUDIO_LANG=English

# Preferred subtitle track. "off" means none.
DEFAULT_SUBTITLE_LANG=off

# [advanced]
# Applied to libraries named in ANIME_LIBRARIES.
ANIME_AUDIO_LANG=Japanese

# [advanced]
ANIME_SUBTITLE_LANG=English

# ---- Images ------------------------------------------------------------

# Let her draw. Needs a ComfyUI server reachable at the address below; off
# until there is one, so the command is not offered when it cannot work.
IMAGE_ENABLED=false

# ComfyUI's address. It binds 127.0.0.1 by default, so a server on another
# machine must be started with --listen for this to reach it.
IMAGE_URL=http://127.0.0.1:8188

# Model file to load, as ComfyUI names it (for example
# sd_xl_base_1.0.safetensors). Leave blank to use whatever the workflow was
# exported with — which is the safer default, since which checkpoints exist
# is a fact about the other machine.
IMAGE_CHECKPOINT=

# [range 1-150]
# Sampler steps. More is slower, not reliably better; 20-30 is the usual
# range for SDXL.
IMAGE_STEPS=25

# [range 256-2048]
# Width in pixels. SDXL was trained at 1024 and gets visibly worse far below
# it.
IMAGE_WIDTH=1024

# [range 256-2048]
# Height in pixels.
IMAGE_HEIGHT=1024

# Applied to every image unless a request overrides it.
IMAGE_NEGATIVE=blurry, low quality, watermark, text, deformed

# [advanced] [range 1-30]
# How hard the sampler is pushed toward the prompt. Above about 12 images
# start to look burnt.
IMAGE_CFG=7.0

# [advanced] [range 30-1800]
# How long to wait for one image. Sized for the hardware, not for patience:
# SDXL on an 8GB card takes tens of seconds, a quantised FLUX with
# offloading takes minutes.
IMAGE_TIMEOUT=180.0

# [range 0.1-1]
# How far an edit may travel from the picture it started with. 1.0 discards
# the original entirely; below about 0.4 the prompt has no room to change
# anything. 0.65 restyles while keeping the composition. A local change that
# must leave the rest of the frame alone needs inpainting, not a lower
# number here.
IMAGE_DENOISE=0.65

# [advanced]
# Used instead of the workflow below when a picture is attached to the
# request. Needs a LoadImage node; the source image sets the size, so
# IMAGE_WIDTH/HEIGHT do not apply.
IMAGE_WORKFLOW_IMG2IMG=workflows/sdxl-img2img.json

# [advanced]
# A ComfyUI graph in API format — not the format the editor saves by
# default. See workflows/README.md.
IMAGE_WORKFLOW=workflows/sdxl.json
