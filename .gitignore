# Secrets. .env holds DISCORD_TOKEN, PLEX_TOKEN, ANTHROPIC_API_KEY and the
# Spotify client secret — it must never be committed. .env.example documents
# the variable names instead.
.env
.env.*
!.env.example

# The control panel's own settings: the port, the remote-access toggle, and an
# scrypt hash of its password. Per-machine, and there is no reason for it to
# travel.
.athena-gui.json
.athena-gui.*.tmp

# Things the person running this supplies, which are theirs and not the
# project's. The idle image is whatever they want on screen when nothing is
# playing — the default is mpv's own — and a voice reference is a recording of
# a real person. Neither belongs in a public repository, and both are exactly
# the kind of file that gets committed by an absent-minded `git add -A`.
/idle.png
/tts/voices/*.wav
# ...and the transcript stored beside each clip. Both halves, or neither: a
# voice reference is the recording AND the words in it, and tracking one
# without the other publishes what somebody said while pretending not to.
/tts/voices/*.json

# Live OAuth tokens.
.spotify-cache

# Runtime state and generated caches, not source.
.mpv-pid
.title-cache.json
prefs.json
logs/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Local agent/editor settings (machine-specific permissions).
.claude/settings.local.json

# OS noise
Thumbs.db
desktop.ini
.DS_Store

# TTS / STT model weights — hundreds of MB, fetched not versioned.
# kokoro-v1.0.onnx alone is 310MB and GitHub rejects anything over 100MB.
models/

# TTS service has its own Python environment — see tts/requirements.txt.
tts/.venv310/
tts/.venv/
# A separate one again for evaluating Chatterbox: it pins torch 2.6.0 and
# would downgrade the working Kokoro service's torch 2.13 if they shared.
tts/.venv-chatterbox/
# The MLX speech environment. Third engine, third virtualenv - mlx-audio
# pulls no torch at all, and Chatterbox pins torch 2.6 against Kokoro's 2.14.
tts/.venv-mlx/
tts/.venv-f5/
tts/*.log
bakeoff.json
bakeoff-round*.json

# Rendered acknowledgement clips — generated on first start, not source.
tts/acks/

# Machine-specific notes for Claude — addresses, hosts, identifiers.
CLAUDE.local.md

# Local experiments and bake-off artifacts. Machine-specific, not a Pantheon feature.
scratchpad/

# Pre-trained voice models and their runtime. 63MB of weights that belong to
# their upstream projects, not here, and a virtualenv rebuilt by setup.
/tts/piper/
/tts/.venv-piper/
